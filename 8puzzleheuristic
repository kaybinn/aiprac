initial_state=[1,5,0,2,3,4,7,8,6]
goal_state=[1,2,3,8,0,4,7,6,5]
def misplaced_tiles(state,goal):
    return sum(1 for i in range(9) if state[i]!= goal[i] and state[i] != 0)
def manhattan_distance(state,goal):
    distance=0
    for i in range(9):
        if state[i] !=0:
            goal_pos= goal.index(state[i])
            current_row,current_col=divmod(i,3)
            goal_row,goal_col=divmod(goal_pos,3)
            distance+= abs(current_row-goal_row)+ abs(current_col-goal_col)
    return distance

misplaced= misplaced_tiles(initial_state,goal_state)
manhattan=manhattan_distance(initial_state,goal_state)
print(f"Misplaced tiles: {misplaced}")
print(f"Manhattan Distance: {manhattan}")
